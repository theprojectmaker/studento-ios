rules_version = '2';
// Studento (project studento-clock) Firebase Storage. Beam videos: each person uploads only
// into their own folder; any signed-in person can watch them (the link travels in a message).
service firebase.storage {
  match /b/{bucket}/o {
    match /beam/{uid}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 60 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
    }
    match /{all=**} {
      allow read, write: if false;
    }
  }
}
