rules_version = '2';
// Studento (project studento-clock). Paste into Firebase console > Firestore > Rules, or
// deploy with scripts/firebase-setup.mjs. Layout is documented at the top of src/lib/api.ts.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isAdmin() {
      return signedIn() && get(/databases/$(database)/documents/users/$(me())).data.get('admin', false) == true;
    }
    function flagOn(name) {
      return !exists(/databases/$(database)/documents/config/flags)
        || get(/databases/$(database)/documents/config/flags).data.get(name, true) != false;
    }
    function banned() { return exists(/databases/$(database)/documents/bans/$(me())); }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function blockedBy(other) {
      return exists(/databases/$(database)/documents/blocks/$(other))
        && me() in get(/databases/$(database)/documents/blocks/$(other)).data.get('ids', []);
    }

    match /config/flags {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Numeric ids for schools, schedules, reports and accounts: +1 at a time only.
    match /counters/{kind} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['next']);
      allow update: if signedIn() && request.resource.data.next == resource.data.next + 1;
    }

    match /users/{uid} {
      allow read: if signedIn() && (me() == uid || isAdmin());
      allow create: if signedIn() && me() == uid && flagOn('signup')
        && request.resource.data.admin == false
        && request.resource.data.keys().hasOnly(['username', 'num', 'admin', 'data', 'updatedAt']);
      allow update: if signedIn() && me() == uid && onlyChanges(['data', 'updatedAt']);
      allow delete: if signedIn() && me() == uid;
    }

    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == me() && name.matches('^[a-z0-9_.-]{3,24}$');
      allow delete: if signedIn() && resource.data.uid == me();
    }

    match /schools/{id} {
      allow read: if true;
      allow create: if signedIn() && flagOn('sharing') && request.resource.data.createdBy == me()
        && request.resource.data.name is string && request.resource.data.name.size() <= 80;
      allow update, delete: if isAdmin();
    }

    match /schedules/{id} {
      allow read: if true;
      allow create: if signedIn() && flagOn('sharing') && request.resource.data.createdBy == me()
        && request.resource.data.name is string && request.resource.data.name.size() <= 40;
      allow update, delete: if isAdmin() || (signedIn() && resource.data.createdBy == me());
    }

    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.uid == me();
      allow read, update, delete: if isAdmin();
    }

    // Share codes: anyone can make one (no account needed); read by exact code only.
    match /shares/{code} {
      allow get: if true;
      allow create: if flagOn('sharing') && code.matches('^[A-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['data', 'createdAt', 'expiresAt'])
        && request.resource.data.expiresAt <= request.time.toMillis() + 31 * 86400000;
    }

    // Blocks: admins (config/admins) can't be blocked.
    match /blocks/{uid} {
      allow read, delete: if signedIn() && me() == uid;
      allow write: if signedIn() && me() == uid
        && (!exists(/databases/$(database)/documents/config/admins)
          || !request.resource.data.get('ids', []).hasAny(get(/databases/$(database)/documents/config/admins).data.get('uids', [])));
    }

    match /chats/{key} {
      // The key is the two uids, so it proves membership even before the chat exists.
      allow get: if signedIn() && key.split('_').hasAny([me()]);
      allow list: if signedIn() && me() in resource.data.members;
      allow create: if signedIn() && flagOn('messaging') && me() in request.resource.data.members
        && request.resource.data.members.size() == 2 && key == request.resource.data.members[0] + '_' + request.resource.data.members[1];
      allow update: if signedIn() && me() in resource.data.members && request.resource.data.members == resource.data.members;
      allow delete: if signedIn() && me() in resource.data.members;

      match /msgs/{msgId} {
        allow read: if signedIn() && (key.split('_').hasAny([me()]) || isAdmin());
        allow create: if signedIn() && flagOn('messaging')
          && key.split('_').hasAny([me()])
          && request.resource.data.from == me() && !banned()
          && request.resource.data.body is string && request.resource.data.body.size() <= 900000
          && !blockedBy(key.split('_')[0] == me() ? key.split('_')[1] : key.split('_')[0]);
        allow delete: if isAdmin() || (signedIn() && key.split('_').hasAny([me()]));
      }
    }

    match /calls/{callId} {
      allow read: if signedIn() && (resource.data.to == me() || resource.data.from == me() || me() in resource.data.members);
      allow create: if signedIn() && flagOn('messaging') && request.resource.data.from == me() && !banned()
        && request.resource.data.members.size() == 2 && me() in request.resource.data.members
        && !blockedBy(request.resource.data.to);
      allow update: if signedIn() && me() in resource.data.members
        && onlyChanges(['status', 'answeredAt', 'endedAt']);
      match /signals/{sig} {
        allow read, create: if signedIn()
          && me() in get(/databases/$(database)/documents/calls/$(callId)).data.members;
      }
    }

    // Live message counter: anyone signed in reads it; a write may only add 1.
    match /stats/global {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['messages']) && request.resource.data.messages == 1;
      allow update: if signedIn() && request.resource.data.keys().hasOnly(['messages'])
        && request.resource.data.messages == resource.data.messages + 1;
    }

    // Monthly TURN relay usage (bytes), for the 900 GB cap. Public read (Apps Script checks it);
    // signed-in calls may only add up to 200 MB per write.
    match /usage/{month} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['turnBytes'])
        && request.resource.data.turnBytes is int && request.resource.data.turnBytes <= 200000000;
      allow update: if signedIn() && request.resource.data.keys().hasOnly(['turnBytes'])
        && request.resource.data.turnBytes > resource.data.turnBytes
        && request.resource.data.turnBytes <= resource.data.turnBytes + 200000000;
    }

    // Pop-up announcements: the admin posts and takes them down.
    match /announcements/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Beam waiting list: a person asks once (status waiting); only the admin lets them in or denies.
    match /access/{uid} {
      allow get: if signedIn() && (me() == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && me() == uid && request.resource.data.status == 'waiting'
        && request.resource.data.keys().hasOnly(['username', 'status', 'at', 'num']);
      allow update, delete: if isAdmin();
    }

    // Bans: 'chat' blocks messages and calls; 'full' also makes the app show a blocked screen.
    match /bans/{uid} {
      allow get: if signedIn() && (me() == uid || isAdmin());
      allow list, write: if isAdmin();
    }

    // Pop-ups the admin sends to one person.
    match /notices/{id} {
      allow read: if signedIn() && (resource.data.to == me() || isAdmin());
      allow write: if isAdmin();
    }

    // Public list of admin accounts (so they can be shown and never blocked).
    match /config/admins {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Friend requests: one doc per pair, id from_to. The receiver accepts; either side can delete.
    match /friendreqs/{id} {
      allow read: if signedIn() && (resource.data.from == me() || resource.data.to == me());
      allow create: if signedIn() && request.resource.data.from == me() && request.resource.data.status == 'pending'
        && id == request.resource.data.from + '_' + request.resource.data.to
        && request.resource.data.keys().hasOnly(['from', 'to', 'fromName', 'toName', 'status', 'at'])
        // the names must be the real usernames of the two people
        && get(/databases/$(database)/documents/usernames/$(request.resource.data.fromName)).data.uid == me()
        && get(/databases/$(database)/documents/usernames/$(request.resource.data.toName)).data.uid == request.resource.data.to;
      allow update: if signedIn() && resource.data.to == me() && onlyChanges(['status']) && request.resource.data.status == 'accepted';
      allow delete: if signedIn() && (resource.data.from == me() || resource.data.to == me());
    }

    // Chess games between two people.
    match /games/{id} {
      allow read: if signedIn() && me() in resource.data.members;
      allow create: if signedIn() && me() in request.resource.data.members && request.resource.data.members.size() == 2
        && request.resource.data.white == me();
      allow update: if signedIn() && me() in resource.data.members
        && onlyChanges(['fen', 'moves', 'status', 'winner', 'updatedAt']);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
